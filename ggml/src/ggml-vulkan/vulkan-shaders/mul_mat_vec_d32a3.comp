#version 450

// Dedicated D32A3 mat-vec / mat-vec-id (MoE) shader.
//
// D32A3 layout (authority: ggml/src/ggml-quants.c dequantize_row_d32a3):
//   32 values per block, one fp16 scale `d`, 12-byte payload = 96 bits = 32 three-bit codes
//   packed LSB-first, value k pairs with activation k (sequential, NOT the IQ interleaved pair).
//   Values are a FIXED 8-level Lloyd-Max codebook, so decode is one table lookup per value and
//   the scale can be hoisted to a single fma per block (mirrors mul_mat_vec_iq4_xs.comp).
//
// Written on purpose against the D32A3 representation instead of the shared mul_mat_vec.comp
// dequantize4 contract, which encodes an interleaved positional mapping that D32A3 does not have.

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

// The codebook is indexed by data-dependent 3-bit codes, so it lives in shared memory:
// a dynamic index into a private const array forces a scratch-memory spill on most compilers.
shared float kvalues_d32a3_sh[8];
const float kvalues_d32a3_mv[8] = float[8](
    -2.151945, -1.343910, -0.756005, -0.245094, 0.245094, 0.756005, 1.343910, 2.151945);

void init_d32a3_shmem() {
    if (gl_LocalInvocationID.x < 8) {
        kvalues_d32a3_sh[gl_LocalInvocationID.x] = kvalues_d32a3_mv[gl_LocalInvocationID.x];
    }
    barrier();
}

// One 24-bit group of 8 consecutive codes (bytes 3l..3l+2), packed LSB-first.
uint d32a3_word8(const uint ibi, const uint l) {
    const uint base = 3 * l;
    return uint(data_a[ibi].qs[base]) | (uint(data_a[ibi].qs[base + 1]) << 8) | (uint(data_a[ibi].qs[base + 2]) << 16);
}

void calc_block(const uint a_offset, const uint b_offset, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    // value index of this block's first element; QUANT_K == 32, so the block is a full row-chunk
    const uint y_idx = i * QUANT_K;

    uint ibi = a_offset + first_row * num_blocks_per_row + i;
    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const float d = float(data_a[ibi].d);

        FLOAT_TYPE sum[NUM_COLS];
        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            sum[j] = FLOAT_TYPE(0);
        }

        [[unroll]] for (uint l = 0; l < 4; ++l) {
            const uint w = d32a3_word8(ibi, l);
            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const vec4 b0 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + 2*l]);
                const vec4 b1 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y_idx) / 4 + 2*l + 1]);
                sum[j] = fma(FLOAT_TYPE(b0.x), FLOAT_TYPE(kvalues_d32a3_sh[(w      ) & 7]),
                        fma(FLOAT_TYPE(b0.y), FLOAT_TYPE(kvalues_d32a3_sh[(w >>  3) & 7]),
                        fma(FLOAT_TYPE(b0.z), FLOAT_TYPE(kvalues_d32a3_sh[(w >>  6) & 7]),
                        fma(FLOAT_TYPE(b0.w), FLOAT_TYPE(kvalues_d32a3_sh[(w >>  9) & 7]),
                        fma(FLOAT_TYPE(b1.x), FLOAT_TYPE(kvalues_d32a3_sh[(w >> 12) & 7]),
                        fma(FLOAT_TYPE(b1.y), FLOAT_TYPE(kvalues_d32a3_sh[(w >> 15) & 7]),
                        fma(FLOAT_TYPE(b1.z), FLOAT_TYPE(kvalues_d32a3_sh[(w >> 18) & 7]),
                        fma(FLOAT_TYPE(b1.w), FLOAT_TYPE(kvalues_d32a3_sh[(w >> 21) & 7]),
                        sum[j]))))))));
            }
        }

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            temp[j][n] = fma(FLOAT_TYPE(d), sum[j], temp[j][n]);
        }

        ibi += num_blocks_per_row;
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;

    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    const uint tid = gl_LocalInvocationID.x;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    // one full 32-value block per thread iteration
    for (uint i = tid; i < num_blocks_per_row; i += gl_WorkGroupSize.x)
        calc_block(a_offset, b_offset, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    init_d32a3_shmem();

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
